<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Android Mirroring</string>

    <!-- Onboarding -->
    <string name="onboarding_title">Use your phone from your Mac</string>
    <string name="onboarding_body">Android Mirroring connects this phone to your Mac over your Wi-Fi, so your Mac can see its battery and make it ring.</string>
    <string name="onboarding_privacy">Nothing leaves the two devices. There is no cloud, no account and no tracking.</string>
    <string name="onboarding_pair">Pair with your Mac</string>

    <!-- Pairing -->
    <string name="pair_title">Pair with your Mac</string>
    <string name="pair_instructions">On your Mac, open Android Mirroring and choose Pair a Phone. Then scan the code it shows.</string>
    <string name="pair_scan">Scan the code</string>
    <string name="pair_scan_prompt">Point your camera at the code on your Mac</string>
    <string name="pair_permission_notifications">Android Mirroring shows a notification while it is connected to your Mac.</string>
    <string name="pair_permission_camera">Android Mirroring needs the camera to scan the code on your Mac.</string>
    <string name="pair_permission_local_network">Android Mirroring needs access to your local network to find your Mac.</string>
    <string name="pair_camera_denied">Without the camera, the code can\'t be scanned. Allow camera access in Settings, then try again.</string>
    <string name="pair_bad_code">That isn\'t an Android Mirroring code. Scan the code on your Mac.</string>
    <string name="pair_connecting">Connecting to %1$s…</string>
    <string name="pair_code_title">Does your Mac show this code?</string>
    <string name="pair_code_description">Pairing code %1$s</string>
    <string name="pair_code_hint">Confirm only if the code on your Mac is the same.</string>
    <string name="pair_confirm">Confirm</string>
    <string name="pair_cancel">Cancel</string>
    <string name="pair_waiting_for_mac">Waiting for your Mac…</string>
    <string name="pair_link_title">Pair with %1$s?</string>
    <string name="pair_link_body">A link wants to pair this phone with a Mac called %1$s. Continue only if you just chose Pair a Phone on your Mac.</string>
    <string name="pair_link_continue">Continue</string>
    <string name="pair_switches_from">You\'ll switch from %1$s to this Mac.</string>
    <string name="pair_done">Paired with %1$s</string>
    <string name="pair_continue">Done</string>
    <string name="pair_try_again">Try again</string>

    <!-- Pairing failures (PairingFailure) -->
    <string name="pair_failure_unreachable">Can\'t reach your Mac. Are both on the same Wi-Fi? Is a VPN on?</string>
    <string name="pair_failure_expired">This code has expired. Show a new code on your Mac.</string>
    <string name="pair_failure_bad_secret">That code didn\'t work. Show a new code on your Mac.</string>
    <string name="pair_failure_rejected">Pairing was cancelled.</string>
    <string name="pair_failure_timed_out">Pairing timed out. Try again.</string>
    <string name="pair_failure_protocol_mismatch">Update Android Mirroring on both devices.</string>

    <!-- Home: connection states (PhoneConnectionState) -->
    <string name="home_title">Your Mac</string>
    <string name="state_connected">Connected to %1$s</string>
    <string name="state_looking">Looking for %1$s…</string>
    <string name="state_looking_unnamed">Looking for your Mac…</string>
    <string name="state_not_recognized">Your Mac doesn\'t recognise this phone any more. Pair again.</string>
    <string name="state_busy">Your Mac is connected to another phone.</string>
    <string name="state_incompatible">Update Android Mirroring on both devices.</string>
    <string name="state_stopped">Not running.</string>
    <string name="home_retry">Try now</string>
    <string name="home_pair_again">Pair again</string>
    <string name="home_pair_again_title">Pair again with your Mac?</string>
    <string name="home_pair_again_body">This phone forgets %1$s. Then scan the new code your Mac shows.</string>
    <string name="home_forget">Forget this Mac</string>
    <string name="home_forget_title">Forget %1$s?</string>
    <!-- Only a connected Mac hears the goodbye; an unreachable one keeps the phone listed. -->
    <string name="home_forget_body_connected">Your Mac will forget this phone too. To use them together again, pair again.</string>
    <string name="home_forget_body_not_connected">Your Mac will keep listing this phone until you remove it there. To use them together again, pair again.</string>
    <string name="home_forget_confirm">Forget</string>

    <!-- Find my phone -->
    <string name="home_stop_ringing">Stop ringing</string>
    <string name="home_stop_ringing_label">Stop ringing this phone</string>
    <string name="home_find_title">Ring at full volume, even on silent</string>
    <string name="home_find_needs_access">To ring when Do Not Disturb is set to Total silence, allow Do Not Disturb access.</string>
    <string name="home_find_granted">Allowed. Your Mac can ring this phone even in Do Not Disturb.</string>
    <!-- Home: show notifications on the Mac -->
    <string name="home_notify_title">Show notifications on your Mac</string>
    <string name="home_notify_needs_access">Android Mirroring needs notification access to do this. Allow it in Settings.</string>
    <string name="home_notify_allow">Allow notification access</string>
    <!-- Home: calls on the Mac -->
    <string name="home_calls_title">Calls on your Mac</string>
    <string name="home_calls_needs_permission">Android Mirroring needs access to your phone\'s call state to do this. Allow it in Settings.</string>
    <string name="home_calls_allow">Allow phone access</string>

    <!-- Home: share contacts with the Mac -->
    <string name="home_contacts_title">Share contacts with your Mac</string>
    <string name="home_contacts_needs_permission">Android Mirroring needs access to your contacts to do this. Allow it in Settings.</string>
    <string name="home_contacts_allow">Allow contacts access</string>
    <string name="home_find_allow">Allow Do Not Disturb access</string>

    <!-- Home: share the clipboard with the Mac -->
    <string name="home_clipboard_title">Share clipboard with your Mac</string>

    <!-- Clipboard: entry points and outcomes -->
    <string name="tile_send_clipboard">Send clipboard to Mac</string>
    <string name="notification_send_clipboard">Send clipboard</string>
    <string name="clipboard_sent">Sent to %1$s</string>
    <string name="clipboard_empty">Clipboard is empty</string>
    <string name="clipboard_not_connected">Not connected to your Mac</string>
    <string name="clipboard_too_long">Text is too long to send</string>
    <string name="clipboard_already_on_mac">Your Mac already has this text</string>
    <string name="clipboard_off">Clipboard sharing is off</string>
    <!-- "Sent to %1$s" when the Mac's name is not known. -->
    <string name="clipboard_mac_unnamed">your Mac</string>

    <!-- Share target: send to the Mac -->
    <string name="share_target">Send to Mac</string>
    <!-- Toast when a shared file's size can't be known, so it can't be sent. -->
    <string name="share_file_unreadable">Couldn\'t send %1$s</string>
    <plurals name="share_files_unreadable">
        <item quantity="one">Couldn\'t send %1$d file</item>
        <item quantity="other">Couldn\'t send %1$d files</item>
    </plurals>

    <!-- Shared from the Mac -->
    <string name="channel_shared">Shared from your Mac</string>
    <string name="channel_shared_description">Links and text your Mac sends to this phone.</string>
    <string name="shared_link_from">Open link from %1$s</string>
    <string name="shared_text_from">Copied from %1$s</string>

    <!-- File transfers -->
    <string name="channel_transfers">File transfers</string>
    <string name="channel_transfers_description">Shows files being sent to and received from your Mac.</string>
    <string name="transfer_sending">Sending %1$s</string>
    <string name="transfer_receiving">Receiving %1$s</string>
    <string name="transfer_saved">Saved to Download/Android Mirroring</string>
    <string name="transfer_send_failed">Couldn\'t send %1$s</string>
    <string name="transfer_receive_failed">Couldn\'t receive %1$s</string>
    <string name="transfer_cancel">Cancel</string>
    <plurals name="transfer_more_waiting">
        <item quantity="one">%1$d more waiting</item>
        <item quantity="other">%1$d more waiting</item>
    </plurals>
    <plurals name="transfer_saved_count">
        <item quantity="one">Saved %1$d file to Download/Android Mirroring</item>
        <item quantity="other">Saved %1$d files to Download/Android Mirroring</item>
    </plurals>
    <plurals name="transfer_send_failed_count">
        <item quantity="one">Couldn\'t send %1$d file</item>
        <item quantity="other">Couldn\'t send %1$d files</item>
    </plurals>
    <plurals name="transfer_receive_failed_count">
        <item quantity="one">Couldn\'t receive %1$d file</item>
        <item quantity="other">Couldn\'t receive %1$d files</item>
    </plurals>
    <string name="transfer_reason_no_space_mac">Not enough space on the Mac.</string>
    <string name="transfer_reason_no_space_phone">Not enough space on the phone.</string>
    <string name="transfer_reason_connection_lost">The connection was lost.</string>
    <string name="transfer_reason_damaged">The file changed or was damaged on the way.</string>
    <string name="transfer_reason_cancelled">Cancelled.</string>
    <string name="transfer_reason_no_answer">Your Mac didn\'t answer.</string>
    <string name="transfer_reason_read_failed">The file couldn\'t be read.</string>
    <string name="transfer_reason_save_failed">The file couldn\'t be saved.</string>
    <string name="transfer_reason_not_found">The file is no longer there.</string>
    <string name="transfer_reason_refused">Your Mac didn\'t take the file.</string>
    <string name="transfer_reason_refused_here">This phone can\'t take this file.</string>

    <!-- Service notification -->
    <string name="channel_connection">Connection</string>
    <string name="channel_connection_description">Shows whether this phone is connected to your Mac.</string>
</resources>
